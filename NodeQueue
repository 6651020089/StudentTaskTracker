#include<iostream>
using namespace std;
typedef struct NodeQueue{
    Congviec data;
    struct nodeQueue *next;
}NodeQueue;
typedef struct hangdoi{
       public:
       NodeQueue *head;
       NodeQueue *tail;
       void khoiTao();
       bool rong();
       void them(Congviec cv);
       Congviec layRa();
       void hienThi();
       void xoaHet();
       int soLuong();
}HangDoiDeadLine;
void HangDoiDeadLine::khoiTao(){
      head=NULL;
      tail=NULL;
      size=0;
}
bool HangDoiDeadLine::rong(){
     return head==NULL;
}
void HangDoiDeadline::them(Congviec cv){
      NodeQueue *p=new NodeQueue;
      p->data=cv;
      p->next=NULL;
if (head==NULL){
           head=p;
           tail=p;
} 
else {
     tail->next=p;
     tail=p;
}
     size ++;
}










